# ===================================================
# JR Real Estate Varanasi - Environment Configuration
# ===================================================

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------
# Supabase PostgreSQL & Prisma Connection
# ---------------------------------------------------
# Connection pooler URL (for Transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for Prisma migrations, port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------
# Supabase Auth & Storage Credentials
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SERVER-SIDE ONLY: Never expose to client-side code!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Storage bucket name for property and project images
SUPABASE_STORAGE_BUCKET="jr-media"

# ---------------------------------------------------
# Business Contact Information
# ---------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME="JR Real Estate Varanasi"
NEXT_PUBLIC_DIRECTOR_NAME="Mr. Umesh Yadav"
NEXT_PUBLIC_OFFICE_PHONE="8948301111"
NEXT_PUBLIC_WHATSAPP_NUMBER="918948301111"
NEXT_PUBLIC_OFFICE_ADDRESS="S9/90A, Pandeypur Chauraha, Varanasi, UP, 221002"
